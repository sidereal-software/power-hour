{
  "name": "power-hour",
  "version": "1.0.0",
  "description": "A serverless Spotify power hour — 60 songs, 60 random timestamps, 60 minutes.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
